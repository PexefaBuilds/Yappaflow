{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yappaflow",
  "version": "0.9.8",
  "identifier": "com.yappaflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream",
        "title": "Yappaflow",
        "width": 1152,
        "height": 648,
        "minWidth": 960,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../licenses/OFL.txt": "licenses/OFL.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMkJFNjlCODI2MzAzNEIKUldSTEEyT0NtK1lySTh2YmJQcUU2VkR5RGdNckNGZ1JmUFFnOWZRbkpheHBMMVZDeG9NNjRDREwK",
      "endpoints": [
        "https://github.com/PexefaBuilds/yappaflow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
